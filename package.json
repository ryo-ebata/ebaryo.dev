    "obsidian:strengthen-links": "node scripts/strengthen-obsidian-links.mjs",
    "audit:design": "node scripts/audit-design-quality.mjs",
    "build": "node scripts/sync-blog-assets.mjs && next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:text": "textlint \"blog-obsidian/public/blogs/**/index.md\"",
    "lint:text:obsidian": "textlint \"blog-obsidian/private/notes/**/*.md\" \"blog-obsidian/private/maps/**/*.md\"",
    "lint:text:obsidian:fix": "textlint --fix \"blog-obsidian/private/notes/**/*.md\" \"blog-obsidian/private/maps/**/*.md\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "type-check": "tsc --noEmit",
    "check": "oxlint . && oxfmt --check . && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:unit": "vitest",
    "test:storybook": "vitest --config vitest.storybook.config.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/design-system-visual.spec.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage"
  },
