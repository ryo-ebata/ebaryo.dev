{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-blog-assets.mjs && NEXT_DIST_DIR=.next-dev next dev",
    "dev:clean": "node scripts/clean-next-dev.mjs && pnpm dev",
    "build": "node scripts/sync-blog-assets.mjs && next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "check:cloudflare-artifacts": "node scripts/check-cloudflare-artifacts.mjs",
    "check:cloudflare-concurrency": "node scripts/check-cloudflare-concurrency.mjs",
    "preview:cloudflare": "pnpm build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare:preview": "pnpm build:cloudflare && opennextjs-cloudflare deploy --env preview",
    "deploy:cloudflare:production": "pnpm build:cloudflare && opennextjs-cloudflare deploy --env production",
    "upload:cloudflare:preview": "pnpm build:cloudflare && opennextjs-cloudflare upload --env preview",
    "upload:cloudflare:production": "pnpm build:cloudflare && opennextjs-cloudflare upload --env production",
    "cf:typegen": "wrangler types --env-file .dev.vars.example --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:text": "textlint \"blog-obsidian/public/blogs/**/index.md\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "type-check": "tsc --noEmit",
    "check": "oxlint . && oxfmt --check . && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:unit": "vitest",
    "test:storybook": "vitest --config vitest.storybook.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@next/third-parties": "^16.3.8",
    "@shikijs/transformers": "^3.21.0",
    "@tabler/icons-react": "^3.35.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "image-size": "^2.0.2",
    "lucide-react": "^0.555.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "next-view-transitions": "^0.3.5",
    "nuqs": "^2.8.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "^4.1.3",
    "@opennextjs/cloudflare": "^1.20.8",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/addon-vitest": "^10.0.8",
    "@storybook/nextjs-vite": "^10.0.8",
    "@storybook/react": "^10.1.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "baseline-browser-mapping": "^2.8.32",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "playwright": "^1.57.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "storybook": "^10.0.8",
    "tailwindcss": "^4",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ai-words-ja": "^1.2.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.14",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@10.7.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "patchedDependencies": {
      "@opennextjs/cloudflare@1.20.8": "patches/@opennextjs__cloudflare@1.20.8.patch"
    }
  }
}
