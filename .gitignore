# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/.next-dev/
/.next-debug/
/.open-next/
/.pnpm-store/
/.wrangler/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.dev.vars.example

# vercel
.vercel

# blog-obsidianの画像をsync-blog-assets.mjsで同期した生成物(正はblog-obsidian/public/blogs/*/images/)
/public/blog-assets
/public/og-assets

# Obsidian Vault: ローカル設定と下書き置き場はgit管理対象外(公開記事はblog-obsidian/public/blogsのみコミットする)
/blog-obsidian/.obsidian
/blog-obsidian/private

# typescript
*.tsbuildinfo
next-env.d.ts
cloudflare-env.d.ts

*storybook.log
storybook-static

# playwright mcp
.playwright-mcp
