# Qiita
QIITA_API_ACCESS_TOKEN=

# アクセス解析（Google Tag Manager。GA4はGTMコンテナ内で設定タグとして発火させる）
NEXT_PUBLIC_GTM_ID=

# Google Search Console のサイト所有権確認コード（未設定ならverification metaタグを出力しない）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google AdSense（未設定なら広告枠は自動的に非表示）
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_LIST=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=

# アフィリエイト（Amazonタグ設定時は記事内のAmazon.co.jpリンクも保存・表示時に自動変換）
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=
# Yahoo!ショッピング（バリューコマース経由。未設定なら素の検索リンク）
NEXT_PUBLIC_VALUECOMMERCE_SID=
NEXT_PUBLIC_VALUECOMMERCE_PID=
